# Copy to .env.local and fill in. Never prefix secrets with NEXT_PUBLIC_.
# Next.js, `npm run db:migrate`, `npm run samples:load` and `npm run test:integration` all read
# .env.local. Variables already set in your shell win over this file.

# --- Required -------------------------------------------------------------------------------
DATABASE_URL=postgres://quizzz:quizzz@localhost:5432/quizzz
# Generate with: openssl rand -base64 32 (at least 32 characters)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Private folder for uploaded documents. Never inside a web-served directory.
STORAGE_DIR=./storage

# Local use only: skip login and act as a built-in local user (true | false, default false).
# Refused when NODE_ENV=production, so it cannot be left on by accident in a deployment.
AUTH_DISABLED=

# --- AI (optional; practice works with AI off) ----------------------------------------------
# gemini | disabled (default)
AI_PROVIDER=disabled
# Server-only. Without a key, AI_PROVIDER=gemini behaves as disabled.
GEMINI_API_KEY=
# Defaults to a free-tier model, see docs/ai-model.md
GEMINI_MODEL=
# AI limits (optional). Application limits: keep them within your provider's own quota.
# Per-user AI operations per minute (default 10)
AI_REQUESTS_PER_MINUTE=
# Per-user AI operations per UTC hour (default 30)
AI_REQUESTS_PER_HOUR=
# Per-user AI operations per UTC day (default 100)
AI_REQUESTS_PER_DAY=
# AI operations per UTC day for the whole app (default 500)
AI_GLOBAL_REQUESTS_PER_DAY=
# AI operations running at once across all app instances (default 2)
AI_MAX_CONCURRENT_CALLS=
# Longest prompt (messages plus system text) sent to the model (default 100000)
AI_MAX_INPUT_CHARS=
# Upper bound on the output tokens any call may ask for (default 4096)
AI_MAX_OUTPUT_TOKENS=

# --- Tuning (optional) ----------------------------------------------------------------------
# Max upload size in bytes (default 10485760 = 10 MB)
MAX_UPLOAD_BYTES=
# Max size of one question image in bytes (default 2097152 = 2 MB)
MAX_IMAGE_BYTES=
# Sign-in / sign-up attempts per minute per client (default 10)
AUTH_RATE_LIMIT_MAX=
# Database connection pool size (default 5)
DB_POOL_MAX=
# Folder with sample course fixtures (default fixtures/sample-courses)
SAMPLES_DIR=

# --- Tests ----------------------------------------------------------------------------------
# A dedicated database; integration tests never use DATABASE_URL. docker compose creates it.
TEST_DATABASE_URL=postgres://quizzz:quizzz@localhost:5432/quizzz_test
