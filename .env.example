# Copy to .env.local and fill in. Never prefix secrets with NEXT_PUBLIC_.
DATABASE_URL=postgres://quizzz:quizzz@localhost:5432/quizzz
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# gemini | disabled (default)
AI_PROVIDER=disabled
GEMINI_API_KEY=
GEMINI_MODEL=
STORAGE_DIR=./storage
# Optional: max sign-in / sign-up attempts per minute per client (default 10)
AUTH_RATE_LIMIT_MAX=
# Optional: max upload size in bytes (default 10485760 = 10 MB)
MAX_UPLOAD_BYTES=
